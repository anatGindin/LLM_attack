import os
import uuid
import json
from tqdm import tqdm
import torch
import transformers
from transformers import AutoModelForCausalLM, AutoTokenizer, pipeline, BitsAndBytesConfig
from huggingface_hub import login
from dotenv import load_dotenv
from constants import (
    DO_SAMPLE, TOP_K, TEMPERATURE, TOP_P, MAX_LENGTH, MAX_NEW_TOKENS,
    HUMAN_EVAL_DATASET, CLASS_EVAL_DATASET
)
from utils import save_json, read_jsonl, add_jsonl_completion, add_jsonl_row, human_eval_generate_prompt, class_eval_generate_prompt, read_json

# Load environment
load_dotenv()
hf_token = os.getenv('HF_TOEKN')
login(hf_token)

def complete_code(tokenizer, pipeline, prompt):
    sequences = pipeline(
        prompt,
        do_sample=DO_SAMPLE,
        top_k=TOP_K,
        temperature=TEMPERATURE,
        top_p=TOP_P,
        num_return_sequences=1,
        eos_token_id=tokenizer.eos_token_id,
        max_new_tokens=MAX_NEW_TOKENS
    )
    return sequences[0]['generated_text']

if __name__ == '__main__':

    # GPU or CPU
    if torch.cuda.is_available():
        print(f"Using GPU: {torch.cuda.get_device_name(0)}")
    else:
        print("Using CPU")
    
    # Directory of this script
    base_dir = os.path.dirname(__file__)

    # Dataset is assumed to be next to this script
    # dataset_path = os.path.join(base_dir, "human-eval-v2-20210705.jsonl")
    # datasets = [ dataset_path ]  # consistent with your previous style
    datasets = ["HumanEval.jsonl"]

    # Output folder
    result_folder_base = os.path.join(base_dir, "generated_outputs", "exp1")

    # # Model config
    # model = 'codellama/CodeLlama-7b-hf'  # example

    # # HuggingFace pipeline
    # tokenizer = AutoTokenizer.from_pretrained(model)
    # device = 0 if torch.cuda.is_available() else -1
    # pipeline = transformers.pipeline(
    #     "text-generation",
    #     model=model,
    #     torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32,
    #     device=device,
    # )
    
    model_name = "codellama/CodeLlama-7b-hf"

    # 1) Define your 8‑bit quantization + CPU‑offload config
    bnb_config = BitsAndBytesConfig(
        load_in_8bit=True,                       # enable 8‑bit quantization
        llm_int8_enable_fp32_cpu_offload=True,   # offload fp32 weights to CPU when they don't fit
    )

    # 2) Load model with quant+offload + auto device_map
    model = AutoModelForCausalLM.from_pretrained(
        model_name,
        quantization_config=bnb_config,
        device_map="auto",           # auto‑shard across GPU & CPU
        torch_dtype=torch.float16,   # keep working set in fp16
    )

    tokenizer = AutoTokenizer.from_pretrained(model_name)

    pipeline = pipeline(
        "text-generation",
        model=model,
        tokenizer=tokenizer,
        max_new_tokens=MAX_NEW_TOKENS,
        do_sample=DO_SAMPLE,
        top_k=TOP_K,
        top_p=TOP_P,
        temperature=TEMPERATURE,
    )

    # Processing datasets
    for dataset in datasets:

            # Create experiment folder
            exp_result = os.path.join(result_folder_base, str(uuid.uuid4()))
            os.makedirs(exp_result, exist_ok=True)
            config_file = os.path.join(exp_result, 'config.json')
            result_file = os.path.join(exp_result, 'result.json')
            
            # Save config
            exp_config = {
                'dataset': dataset,
                'task': 'code_completion',
                'generation_config': {
                    'do_sample': DO_SAMPLE,
                    'top_k': TOP_K,
                    'temperature': TEMPERATURE,
                    'top_p': TOP_P,
                    'max_length': MAX_LENGTH,
                    'max_new_tokens': MAX_NEW_TOKENS
                }
            }
            save_json(save_file=config_file, object=exp_config)

            # Determine type (here it's always HumanEval)
            if HUMAN_EVAL_DATASET in dataset or dataset.endswith("HumanEval.jsonl"):
                generarate_prompt = human_eval_generate_prompt
                data_inputs = read_jsonl(dataset)
                task_id_ = 'task_id'
            elif CLASS_EVAL_DATASET in dataset:
                generarate_prompt = class_eval_generate_prompt
                data_inputs = read_json(dataset)
                task_id_ = 'task_id'
            else:
                print("Unknown dataset type")
                exit()

            # Main loop
            for i in tqdm(range(len(data_inputs)), desc="Processing data"):
                input_ = data_inputs[i]
                input_id = input_[task_id_]
                prompts = generarate_prompt(input_)
                for prompt in prompts:
                    to_save_row = {
                        "task_id": input_id,
                        "prompt": prompt,
                        "result": []
                    }
                    add_jsonl_row(result_file, to_save_row)
                    completion = complete_code(tokenizer=tokenizer, pipeline=pipeline, prompt=prompt)
                    add_jsonl_completion(result_file, model=model_name, completion=completion)
